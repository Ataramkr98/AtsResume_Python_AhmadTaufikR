# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Required when serving the app from a custom domain over HTTPS, comma separated.
# Example: CSRF_TRUSTED_ORIGINS=https://ats.example.com
CSRF_TRUSTED_ORIGINS=
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the bundled SQLite file (fastest local path).
# Postgres / Neon (recommended for production):
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# MySQL (used by the Docker Compose stack):
#   DATABASE_URL=mysql://ats:ats@mysql:3306/ats
DATABASE_URL=
# Seconds to keep a database connection open. 0 in DEBUG, 600 in production by default.
DB_CONN_MAX_AGE=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Leave REDIS_URL empty in DEBUG and the resume pipeline runs inline instead of via Celery.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------------
# Object storage (S3 / MinIO). Leave USE_S3=false to store uploads on disk.
# ---------------------------------------------------------------------------
USE_S3=false
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=ats-resumes
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=ATS <noreply@ats.local>

# ---------------------------------------------------------------------------
# Uploads and malware scanning
# ---------------------------------------------------------------------------
MAX_RESUME_MB=10
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=true

# ---------------------------------------------------------------------------
# Security. All three are required whenever DJANGO_DEBUG=false.
# ---------------------------------------------------------------------------
# Fernet key for field-level PII encryption:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in development to derive a key from DJANGO_SECRET_KEY. Set it explicitly in
# production: changing DJANGO_SECRET_KEY later would otherwise make stored PII unreadable.
FIELD_ENCRYPTION_KEY=
# Keyed hash pepper for candidate email/phone lookups. Use a different value from the secret key.
PII_HASH_KEY=change-me-separately
# Redirect plain HTTP to HTTPS behind a proxy. Disable only for local production smoke tests.
SECURE_SSL_REDIRECT=true
MFA_ENFORCEMENT=true

# ---------------------------------------------------------------------------
# Demo workspace
# ---------------------------------------------------------------------------
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123

# ---------------------------------------------------------------------------
# Shared AI gateway (OpenAI-compatible)
# ---------------------------------------------------------------------------
# Match scoring runs on the deterministic rules engine and needs no network
# call. These settings only power the optional recruiter-facing narrative that
# sits *next to* the score, and only when AI_NARRATIVE_SCORES=1. Never commit a
# real key.
AI_BASE_URL=https://ai.autoapp.biz.id/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Model selection per feature. Allowed: minimax-m3 | glm-5.3-flash | kimi-k3
AI_MODEL_DEFAULT=minimax-m3
AI_MODEL_CHAT=
AI_MODEL_ANALYZE=glm-5.3-flash
AI_MODEL_GENERATE=minimax-m3
AI_MODEL_SUMMARIZE=glm-5.3-flash

# Opt-in. Leave false to keep scoring exactly as it is today. The hiring
# disclaimer is always retained and no score is ever changed by the model.
AI_NARRATIVE_SCORES=false
